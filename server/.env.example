PORT=4000

# PostgreSQL connection URL; use a direct/session connection for migrations.
DATABASE_URL=

# BullMQ Redis connection. Use the host, port and password from your provider.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional ACL username (often default); leave blank if not required.
REDIS_USERNAME=
# Set true when your provider requires TLS.
REDIS_TLS=false

# ImageKit server credentials; fill real values only in .env.local.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
