generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum PolicyStatus {
  active
  expired
  cancelled
  inactive
}

enum PremiumStatus {
  paid
  unpaid
  pending
}

enum OwnershipType {
  owner
  tenant
  leaseholder
}

enum CropSeason {
  kharif
  rabi
  zaid
}

enum CoveredPeril {
  flood
  lodging
  drought
  hailstorm
  unseasonal_rain
}

enum ClaimStatus {
  pending
  queued
  processing
  awaiting_analysis
  needs_correction
  needs_review
  failed
}

enum ClaimStage {
  upload
  dispatch
  insurance
  awaiting_analysis
  finished
}

model Claim {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotency_key       String       @unique @db.VarChar(128)
  request_hash          String       @db.Char(64)
  policy_number         String
  owner_demo_id         String
  owner_name            String
  plot_id               String
  crop                  String
  season                CropSeason
  season_year           Int
  peril                 CoveredPeril
  event_date            DateTime     @db.Date
  latitude              Decimal?     @db.Decimal(9, 6)
  longitude             Decimal?     @db.Decimal(9, 6)
  description           String?
  status                ClaimStatus  @default(pending)
  stage                 ClaimStage   @default(upload)
  images_ready          Boolean      @default(false)
  insurance_result      Json?
  attempt_count         Int          @default(0)
  processing_token      String?      @db.Uuid
  last_error            String?
  queued_at             DateTime?    @db.Timestamptz(6)
  processing_started_at DateTime?    @db.Timestamptz(6)
  finished_at           DateTime?    @db.Timestamptz(6)
  created_at            DateTime     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  images                ClaimImage[]
  outbox                ClaimOutbox?

  @@index([status, updated_at])
  @@index([policy_number, plot_id, event_date])
  @@map("claims")
}

model ClaimImage {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claim_id         String    @db.Uuid
  claim            Claim     @relation(fields: [claim_id], references: [id], onDelete: Restrict)
  imagekit_file_id String    @unique
  url              String
  file_name        String
  mime_type        String
  size_bytes       Int
  cleanup_pending  Boolean   @default(false)
  deleted_at       DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([claim_id])
  @@index([cleanup_pending])
  @@map("claim_images")
}

/// Delivery metadata only. The Claim row owns business status and results.
model ClaimOutbox {
  claim_id      String    @id @db.Uuid
  claim         Claim     @relation(fields: [claim_id], references: [id], onDelete: Restrict)
  attempt_count Int       @default(0)
  available_at  DateTime  @default(now()) @db.Timestamptz(6)
  dispatched_at DateTime? @db.Timestamptz(6)
  last_error    String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([dispatched_at, available_at])
  @@map("claim_outbox")
}

/// One issued policy for an owner, crop, plot, and season.
/// Owner details are the issuance snapshot, not an authentication account.
model InsurancePolicy {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policy_number      String @unique
  application_number String @unique
  insurer_name       String
  scheme_name        String

  owner_demo_id  String
  owner_name     String
  owner_phone    String?
  owner_email    String?
  ownership_type OwnershipType

  village               String
  district              String
  state                 String
  plot_id               String
  plot_latitude         Decimal @db.Decimal(9, 6)
  plot_longitude        Decimal @db.Decimal(9, 6)
  insured_area_hectares Decimal @db.Decimal(10, 4)

  crop           String
  season         CropSeason
  season_year    Int
  covered_perils CoveredPeril[]
  issued_on      DateTime       @db.Date
  coverage_start DateTime       @db.Date
  coverage_end   DateTime       @db.Date

  sum_insured_inr    Decimal       @db.Decimal(14, 2)
  premium_amount_inr Decimal       @db.Decimal(12, 2)
  premium_status     PremiumStatus
  policy_status      PolicyStatus

  is_synthetic Boolean  @default(false)
  seed_batch   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([owner_demo_id])
  @@index([plot_id, season, season_year])
  @@index([seed_batch])
  @@map("insurance_policies")
}
