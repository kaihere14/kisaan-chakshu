{
  "name": "kisaan-chakshu-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/claim/claim.worker.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "worker:start": "node dist/claim/claim.worker.js",
    "typecheck": "prisma generate && tsc --project tsconfig.scripts.json --noEmit",
    "test": "prisma generate && node --import tsx --test tests/*.test.ts",
    "generate": "prisma generate",
    "create-officer": "tsx scripts/create-officer.ts",
    "migration": "prisma migrate dev",
    "migration:deploy": "prisma migrate deploy",
    "migration:status": "prisma migrate status",
    "seed": "prisma db seed",
    "seed:preview": "tsx prisma/seed.ts --dry-run",
    "db:setup": "bun run generate && bun run migration:deploy && bun run seed",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.14.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.5.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "5",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
